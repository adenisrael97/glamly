# ─── Glamly API environment ───────────────────────────────────────────────────
# Copy to .env and fill in real values. config/index.ts validates these on boot
# and the process exits if any required var is missing or malformed.

# Postgres connection string (the only persistence store).
DATABASE_URL="postgresql://glamly:glamly_dev_password@localhost:5433/glamly"

# Redis — refresh tokens, rate limits, push subscriptions.
REDIS_URL="redis://:glamly_redis_password@localhost:6379"

PORT=4000
NODE_ENV=development

# JWT signing secrets — must each be ≥ 32 chars. Use long random values in prod.
JWT_ACCESS_SECRET=dev_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=dev_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated CORS allowlist (never "*" in production).
CORS_ORIGINS=http://localhost:3000

# ─── Paystack ─────────────────────────────────────────────────────────────────
# Server-side secret key from the Paystack dashboard (sk_test_… in test mode).
# This key both authenticates API requests AND is the HMAC-SHA512 key used to
# verify webhook signatures — payment confirmation trusts the signed webhook only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Override only for local stubs / tests.
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack redirects the customer after checkout (a client callback only;
# it never confirms a booking — that is webhook-driven).
PAYSTACK_CALLBACK_URL=http://localhost:3000/bookings

# ─── Notifications: email (Resend) ──────────────────────────────────────────────
# Transactional email via Resend + React Email. When RESEND_API_KEY is unset the
# integration fails soft: emails are rendered and logged but not delivered, so the
# server still boots and bookings still work in local dev.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Glamly <noreply@glamly.ng>"
# Public web app URL — used to build links inside emails and push notifications.
WEB_APP_URL=http://localhost:3000

# ─── Notifications: web push (VAPID) ────────────────────────────────────────────
# Generate a keypair once with: npx web-push generate-vapid-keys
# When unset, push delivery is skipped (the public-key endpoint still responds so
# the client degrades gracefully).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@glamly.ng

# ─── Cloudinary (image storage — avatars + portfolios) ─────────────────────────
# From Cloudinary dashboard → Settings → API Keys.
# When any of these three vars is absent, upload endpoints return 503 with
# UPLOAD_NOT_CONFIGURED — the server still boots and all other features work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Error reporting (Sentry, §13) ──────────────────────────────────────────────
# Optional. When unset, the Sentry SDK never initialises and error capture is a
# no-op, so the API runs locally and in CI without a Sentry project. Set in prod to
# report unhandled errors (tagged with the request correlation id).
SENTRY_DSN=
# Performance tracing sample rate (0–1). Leave 0 to disable tracing.
SENTRY_TRACES_SAMPLE_RATE=0
