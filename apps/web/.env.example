# Base URL of the Glamly REST API (the only contract between web and api besides
# the shared package). Must include the versioned prefix. The Axios client in
# lib/api/client.ts reads this at build/runtime; it is the sole place the web app
# learns where the backend lives.
#
# Local default matches apps/api PORT=4000. When 4000 is taken, run the API on an
# alternate port and override this in .env.local (e.g. http://localhost:4100/api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
