# Base URL of the Glamly REST API (the only contract between web and api besides
# the shared package). Must include the versioned prefix. The Axios client in
# lib/api/client.ts reads this at build/runtime; it is the sole place the web app
# learns where the backend lives.
#
# Local default matches apps/api PORT=4000. When 4000 is taken, run the API on an
# alternate port and override this in .env.local (e.g. http://localhost:4100/api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Error reporting (Sentry, §13) ──────────────────────────────────────────────
# Optional. When unset, the Sentry SDK never initialises (no-op), so local and CI
# builds need no Sentry project. The DSN is a public identifier, not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Client perf-tracing sample rate (0–1). Leave 0 to disable tracing.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-time source-map upload (CI/prod only). Without SENTRY_AUTH_TOKEN the build
# still succeeds and simply skips upload. org/project name the Sentry destination.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
