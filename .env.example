# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=glamly
POSTGRES_PASSWORD=glamly_dev_password
POSTGRES_DB=glamly
POSTGRES_PORT=5433

DATABASE_URL="postgresql://glamly:glamly_dev_password@localhost:5433/glamly"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=glamly_redis_password
REDIS_PORT=6379
REDIS_MAXMEMORY=128mb
REDIS_URL="redis://:glamly_redis_password@localhost:6379"

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Glamly <noreply@glamly.ng>"
WEB_APP_URL=http://localhost:3000

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:noreply@glamly.ng

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Web (Next.js public env vars, baked in at build time) ───────────────────
# Point to the API base URL — must include /api/v1 suffix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
